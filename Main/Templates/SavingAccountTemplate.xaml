<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Main.Templates.SavingAccountTemplate"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Margin="24,12,24,0" ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto,Auto">

        <!-- Zone Label + AccountNo -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding ClickEditAccountCommand}"
                    CommandParameter="{Binding}" />
            </Grid.GestureRecognizers>

            <Grid ColumnDefinitions="Auto, Auto">
                <Label Grid.Column="0"
                       Text="{Binding Label}"
                       Margin="0,0,5,0"
                       FontSize="18"
                       FontAttributes="Bold" />

                <Label Grid.Column="1"
                       Text="{Binding AccountNo}"
                       FontSize="14"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Zone Montant -->
        <Label Grid.Column="2"
               Text="{Binding Balance, StringFormat='{0:N2} €'}"
               FontSize="14"
               TextColor="CadetBlue"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding ClickEditBalanceCommand}"
                    CommandParameter="{Binding}" />
            </Label.GestureRecognizers>
        </Label>

        <BoxView Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3"
                 HeightRequest="1"
                 BackgroundColor="#E0E0E0"
                 Margin="0,12,0,0" />
    </Grid>

</ContentView>

