<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    x:Class="Main.Templates.ScpiTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Margin="24,12,24,0"  RowDefinitions="Auto,Auto,Auto">

        <Grid Grid.Row="0" >
            <Grid.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding ClickEditAccountCommand}"
                    CommandParameter="{Binding}" />
            </Grid.GestureRecognizers>

            <Grid ColumnDefinitions="Auto, Auto">
                <Label Grid.Column="0"
                       Text="{Binding Label}"
                       Margin="0,0,5,0"
                       FontSize="18"
                       FontAttributes="Bold" />

                <Label Grid.Column="1"
                       Text="{Binding AccountNo}"
                       FontSize="14"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding ClickEditBalanceCommand}"
                    CommandParameter="{Binding}" />
            </Grid.GestureRecognizers>

            <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto">

                <Label Grid.Column="0" Grid.Row="0" 
                       Text="{Binding Ligne1}" 
                       FontSize="14" 
                       HorizontalTextAlignment="End"
                       FontAttributes="None" />
                <Label Grid.Column="0" Grid.Row="1" 
                       Text="{Binding Ligne2}" 
                       FontSize="14" 
                       HorizontalTextAlignment="End"
                       FontAttributes="None" />
            </Grid>
        </Grid>


        <BoxView Grid.Row="2" 
                 HeightRequest="1"
                 BackgroundColor="#E0E0E0"
                 Margin="0,12,0,0" />
    </Grid>


</ContentView>


