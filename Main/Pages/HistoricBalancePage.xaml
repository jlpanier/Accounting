<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Main.Pages.HistoricBalancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:templates="clr-namespace:Main.Templates"
    xmlns:selectors="clr-namespace:Main.Templates"
    xmlns:customs="clr-namespace:Main.Customs"
    BackgroundColor="AliceBlue"
    Title="Historique">

    <ContentPage.BindingContext>
        <vm:HistoricBalanceViewModel />
    </ContentPage.BindingContext>

    <ScrollView Margin="10" BackgroundColor="AliceBlue">
        <Grid BackgroundColor="AliceBlue" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

            <Label 
                Grid.Row="0" 
                Text="{Binding Titel}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />
            <Label 
                Grid.Row="1" 
                Text="{Binding SubTitel}"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />

            <Border Grid.Row="2" Margin="0" Padding="12" StrokeThickness="0" Background="AliceBlue">

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Balances}"
                    SelectionMode="None"
                    Margin="100,0,100,0">

                    <CollectionView.Header>
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0" FontSize="12" Text="" MinimumWidthRequest ="72" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" FontSize="12" Text="Balance"  HorizontalOptions="Center"/>
                         </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,*" >
                                    <Label Grid.Column="0" Text="{Binding EffectiveOn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Balance, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#DADADA" Margin="0,4,0,4" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>


                </CollectionView>



            </Border>

        </Grid>
    </ScrollView>
</ContentPage>