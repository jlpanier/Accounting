<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Main.Pages.HistoricAppartmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    xmlns:templates="clr-namespace:Main.Templates"
    xmlns:selectors="clr-namespace:Main.Templates"
    xmlns:customs="clr-namespace:Main.Customs"
    BackgroundColor="AliceBlue"
    Title="Comptes rendu de gestion">

    <ContentPage.BindingContext>
        <vm:HistoricAppartmentViewModel />
    </ContentPage.BindingContext>

    <ScrollView Margin="10" BackgroundColor="AliceBlue">
        <Grid BackgroundColor="AliceBlue" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

            <Label 
                Grid.Row="0" 
                Text="{Binding Titel}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />
            <Label 
                Grid.Row="1" 
                Text="{Binding SubTitel}"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />

            <Border Grid.Row="2" Margin="0" Padding="12" StrokeThickness="0" Background="AliceBlue">

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Balances}"
                    SelectionMode="None"
                    Margin="20"
                    >

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,*" >
                                    <Label Grid.Column="0" Text="{Binding EffectiveOn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Transfer, StringFormat='{0:N2} €'}" TextColor="CadetBlue" FontSize="14" HorizontalOptions="End" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                </Grid>
                                <Label Grid.Column="1" Text="{Binding Renter, StringFormat='➤ {0}'}" FontSize="12" VerticalTextAlignment="Center" />

                                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions ="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="12">

                                    <Label Padding="0" Grid.Column="0" Grid.Row="1" Text="Loyer" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="1" Grid.Row="1" Text="{Binding Rent, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="0" Grid.Row="2" Text="Provision" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="1" Grid.Row="2" Text="{Binding Provision, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <BoxView Grid.Column="1" Grid.Row="3" HeightRequest="1" BackgroundColor="#DADADA" Margin="12,4,12,4" />
                                    <Label Padding="0,0,12,0" Grid.Column="1" Grid.Row="4" Text="{Binding Credit, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontAttributes="Bold" />

                                    <Label Grid.Column="2" Grid.Row="1" Text="Entrée/Sortie" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="1" Text="{Binding InOut, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Grid.Row="2" Text="Travaux" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="2" Text="{Binding Work, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Grid.Row="3" Text="Exceptionel" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="3" Text="{Binding Exceptionel, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Grid.Row="4" Text="Garantie" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="4" Text="{Binding Garantee, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Grid.Row="5" Text="Gestion" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="5" Text="{Binding Gestion, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" Grid.Row="6" Text="Syndic" FontSize="10" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="6" Text="{Binding Syndic, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    <BoxView Grid.Column="3" Grid.Row="7" HeightRequest="1" BackgroundColor="#DADADA" Margin="12,4,12,4" />
                                    <Label Padding="0,0,12,0" Grid.Column="3" Grid.Row="8" Text="{Binding Debit, StringFormat='{0:N2} €'}" FontSize="10" TextColor="CadetBlue" HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontAttributes="Bold" />

                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#DADADA" Margin="0,4,0,4" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>


                </CollectionView>



            </Border>

        </Grid>
    </ScrollView>
</ContentPage>