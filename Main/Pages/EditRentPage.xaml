<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    x:Class="Main.Pages.EditRentPage"
    xmlns:converter="clr-namespace:Main.Converter"
    Title="Saisie compte rendu">
    <ContentPage.BindingContext>
        <vm:EditRentViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:DoubleConverter x:Key="DoubleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="22">

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#EEF8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Date "
                        FontSize="18"
                        FontAttributes="Bold" />

                    <DatePicker Date="{Binding EffectiveOn, Mode=TwoWay}"
                            Format="dd/MM/yyyy" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Locataire"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="Locataire"
                        Keyboard="Numeric"
                        Text="{Binding Renter, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#E8F2FF"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Loyer"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry 
                    Placeholder="Loyer"
                    Text="{Binding Rent, Mode=TwoWay, Converter={StaticResource DoubleConverter}}"
                    Keyboard="Numeric"
                    VerticalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFF4E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Provision"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Provision, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Entrée / Sortie"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding InOut, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Travaux"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Work, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Frais exceptionnel"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Exceptionel, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Assurance loyer impayé"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Garantee, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Gestion"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Gestion, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Syndic"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Syndic, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#FFE8E8"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Virement"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry Placeholder="0,00 €"
                        Keyboard="Numeric"
                        Text="{Binding Transfer, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>


            <Grid  ColumnDefinitions="*,*,*" >
                <Button Grid.Column="0"
                    Margin="0,0,12,0"
                    Text="Enregistrer"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickSaveCommand}" />

                <Button Text="Annuler" Grid.Column="1"
                    Margin="12,0,12,0"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickCancelCommand}" />

                <Button Text="Historique" Grid.Column="2"
                    Margin="12,0,12,0"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickHistoricCommand}" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
