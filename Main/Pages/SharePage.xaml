<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Main.Pages.SharePage"
             Title="Actions">
    <VerticalStackLayout Padding="20" Spacing="18">


        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto">
            <Label Grid.Column="0" Grid.Row="0" Text="Nom" FontSize="12" Padding="12" HorizontalOptions="Center" VerticalOptions="Center" />
            <Entry Grid.Column="1" Grid.Row="0" Placeholder="..." Text="{Binding Label}" />
            <Label Grid.Column="0" Grid.Row="1" Text="Code" FontSize="12" Padding="12" HorizontalOptions="Center" VerticalOptions="Center" />
            <Entry Grid.Column="1" Grid.Row="1" Placeholder="FR000000" Text="{Binding Code}" />
            <Label Grid.Column="0" Grid.Row="3" Text="Type de gestion" FontSize="12" Padding="12" HorizontalOptions="Center" VerticalOptions="Center" />
            <Picker Grid.Column="1" Grid.Row="3" ItemsSource="{Binding ShareTypes}" SelectedItem="{Binding SelectedShareType}" FontSize="14" ItemDisplayBinding="{Binding .}"/>
        </Grid>

        <Grid  ColumnDefinitions="*,*,*" >

            <Button Grid.Column="0"
                    Margin="0,0,12,0"
                    Text="Enregister"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickSaveCommand}" />

            <Button Text="Annuler" Grid.Column="1"
                    Margin="12,0,12,0"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    Command="{Binding ClickCancelCommand}" />

            <Button Text="Supprimer" Grid.Column="2"
                    Margin="12,0,0,0"
                    CornerRadius="12"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    IsVisible="{Binding CanDelete}"
                    Command="{Binding ClickDeleteCommand}" />

 

        </Grid>

    </VerticalStackLayout>

</ContentPage>